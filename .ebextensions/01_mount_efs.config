packages:
  yum:
    amazon-efs-utils: []

files:
  "/opt/mount-efs.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      FS_ID="fs-0e4fe5cac543f75b7"
      MOUNT_POINT="/mnt/efs"
      UPLOADS="$MOUNT_POINT/uploads"

      # uid/gid www-data di image php:7.4-apache-bullseye (Debian). Worker Apache
      # menurunkan hak ke user ini, jadi dialah yang benar-benar menulis file —
      # bukan root, dan bukan uid 1000.
      WEB_UID=33
      WEB_GID=33

      log() { echo "[mount-efs] $*"; }

      mkdir -p "$MOUNT_POINT"

      # EFS punya mount target di 1a/1b/1c, jadi instance boleh pindah AZ kapan saja.
      if ! grep -q "$FS_ID" /etc/fstab; then
        echo "$FS_ID:/ $MOUNT_POINT efs _netdev,tls,noresvport 0 0" >> /etc/fstab
      fi

      if mountpoint -q "$MOUNT_POINT"; then
        log "sudah ter-mount"
      else
        log "mounting $FS_ID -> $MOUNT_POINT"
        mount -t efs -o tls,noresvport "$FS_ID:/" "$MOUNT_POINT"
      fi

      # -----------------------------------------------------------------------
      # Inisialisasi struktur folder.
      #
      # Aplikasi TIDAK PERNAH memanggil mkdir sebelum menyimpan file — lihat
      # uploadFile() di libs/functions.php yang langsung move_uploaded_file() ke
      # UPLOADFOLDER.$dir."/". Kalau subfolder-nya belum ada, PHP hanya memberi
      # warning dan mengembalikan false: nama file tetap tersimpan di database
      # tapi file fisiknya tidak pernah ada. EFS yang baru dibuat isinya kosong,
      # jadi tanpa langkah ini SEMUA upload gagal tanpa suara.
      #
      # Daftar di bawah adalah gabungan folder yang direferensikan di kode
      # (UPLOADFOLDER."<x>/") dan yang dipakai lewat nama tabel di
      # refController::  uploads/<tbl>/.
      # -----------------------------------------------------------------------
      mkdir -p "$UPLOADS"
      for d in \
        docs \
        dtp \
        kml \
        monitoring \
        pengumuman \
        peta_sebaran \
        raport \
        respon \
        rhl_detail \
        rth \
        rth_detail \
        rth_detail_json \
        sk_pelaksana \
        tutupan \
        tutupan_detail \
        tutupan_detail_json
      do
        mkdir -p "$UPLOADS/$d"
      done

      # chown non-rekursif: cukup untuk direktori yang baru dibuat, dan tidak
      # menyeret seluruh isi EFS setiap deploy (rekursif di atas NFS lambat).
      chown "$WEB_UID:$WEB_GID" "$UPLOADS"
      chmod 2775 "$UPLOADS"
      find "$UPLOADS" -maxdepth 1 -mindepth 1 -type d \
        -exec chown "$WEB_UID:$WEB_GID" {} + \
        -exec chmod 2775 {} +

      log "siap:"
      df -h "$MOUNT_POINT"
      ls -la "$UPLOADS"

commands:
  01_mount_efs:
    command: "/opt/mount-efs.sh"
