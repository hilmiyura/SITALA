# EFS untuk folder upload.
#
# CATATAN: sengaja TIDAK memakai blok `packages: yum:`.
#
# cfn-init menjalankan `yum clean metadata` + `yum makecache` setiap kali blok
# `packages` ada — membangun ulang cache metadata SELURUH repo AL2023 (76 MB),
# butuh ~340 MB RSS. Di instance t3a.micro (1 GB RAM) yang sudah menjalankan
# container PHP/Apache + Docker daemon + healthd, kernel membunuh prosesnya:
#
#   kernel: Out of memory: Killed process (yum) anon-rss:334328kB
#   systemd: cfn-hup.service: Failed with result 'oom-kill'
#
# Akibatnya deployment menggantung sampai command timeout EB, dan `commands`
# di bawah tidak pernah dieksekusi sama sekali. Karena itu instalasi paket
# dipindah ke `commands`, dijalankan setelah swap tersedia dan hanya kalau
# paketnya memang belum terpasang.

files:
  "/opt/ensure-swap.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      SWAPFILE="/swapfile"
      log() { echo "[swap] $*"; }

      if swapon --show=NAME --noheadings 2>/dev/null | grep -q .; then
        log "swap sudah aktif"
      else
        if [ ! -f "$SWAPFILE" ]; then
          log "membuat $SWAPFILE 1G"
          # fallocate gagal di sebagian filesystem; dd selalu bisa.
          fallocate -l 1G "$SWAPFILE" 2>/dev/null \
            || dd if=/dev/zero of="$SWAPFILE" bs=1M count=1024 status=none
          chmod 600 "$SWAPFILE"
          mkswap "$SWAPFILE" >/dev/null
        fi
        swapon "$SWAPFILE"
        log "swap aktif"
      fi

      # nofail: swapfile yang hilang tidak boleh menggagalkan boot.
      grep -q "^${SWAPFILE} " /etc/fstab \
        || echo "${SWAPFILE} none swap sw,nofail 0 0" >> /etc/fstab

      free -m

  "/opt/mount-efs.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      FS_ID="fs-0e4fe5cac543f75b7"
      MOUNT_POINT="/mnt/efs"
      UPLOADS="$MOUNT_POINT/uploads"

      # uid/gid www-data di image php:7.4-apache-bullseye (Debian). Worker Apache
      # menurunkan hak ke user ini, jadi dialah yang benar-benar menulis file —
      # bukan root, dan bukan uid 1000.
      WEB_UID=33
      WEB_GID=33

      log() { echo "[mount-efs] $*"; }
      die() { echo "[mount-efs] GAGAL: $*" >&2; exit 1; }

      # amazon-efs-utils menyediakan `mount -t efs` beserta stunnel untuk opsi
      # tls. Dipasang di sini, bukan lewat blok `packages` — lihat catatan di
      # kepala file soal OOM.
      if [ -x /sbin/mount.efs ] || [ -x /usr/sbin/mount.efs ]; then
        log "amazon-efs-utils sudah terpasang"
      else
        log "memasang amazon-efs-utils"
        dnf install -y --setopt=install_weak_deps=False amazon-efs-utils \
          || die "gagal memasang amazon-efs-utils"
      fi

      mkdir -p "$MOUNT_POINT"

      # -----------------------------------------------------------------------
      # Bersihkan entri fstab lebih dulu, SEBELUM apa pun yang bisa gagal.
      #
      # Entri fstab yang menunjuk EFS tak terjangkau bikin instance gagal boot
      # (systemd masuk emergency mode) — kondisi yang jauh lebih buruk daripada
      # deploy yang gagal. Jadi urutannya: hapus dulu, pasang lagi hanya setelah
      # mount TERBUKTI berhasil. Kalau script ini mati di tengah jalan, instance
      # tetap bisa reboot dengan selamat.
      # -----------------------------------------------------------------------
      sed -i "\|^${FS_ID}:|d" /etc/fstab

      # Mount lama yang menggantung membuat SEMUA operasi file di bawahnya
      # (termasuk mountpoint/stat/df) memblokir selamanya di D-state. /proc/mounts
      # dibaca dari memori kernel sehingga aman, dan `umount -l` melepas tanpa
      # menyentuh filesystem-nya.
      if grep -q " ${MOUNT_POINT} " /proc/mounts; then
        log "melepas mount lama di $MOUNT_POINT"
        umount -f -l "$MOUNT_POINT" 2>/dev/null || true
      fi

      # -----------------------------------------------------------------------
      # Probe konektivitas sebelum mount.
      #
      # Kalau port 2049 tertutup, security group MEMBUANG paket tanpa mengirim
      # RST — `mount -t efs` tidak gagal, ia me-retry sampai command timeout EB
      # menghabisinya. Probe 5 detik mengubahnya jadi pesan yang jelas.
      # -----------------------------------------------------------------------
      TOKEN=$(curl -sS -m 5 -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 300") \
        || die "tidak bisa mengambil token IMDSv2"
      REGION=$(curl -sS -m 5 -H "X-aws-ec2-metadata-token: $TOKEN" \
        "http://169.254.169.254/latest/meta-data/placement/region") \
        || die "tidak bisa membaca region dari IMDS"

      # DNS EFS menjawab dengan IP mount target di AZ instance ini.
      EFS_HOST="${FS_ID}.efs.${REGION}.amazonaws.com"
      MT_IP=$(getent hosts "$EFS_HOST" | awk '{print $1; exit}') \
        || die "DNS $EFS_HOST tidak resolve. Pastikan enableDnsHostnames & enableDnsSupport aktif di VPC, dan ada mount target di AZ instance ini."
      [ -n "$MT_IP" ] || die "DNS $EFS_HOST resolve kosong."

      log "mount target di AZ ini: $MT_IP"

      if ! timeout 5 bash -c "exec 3<>/dev/tcp/${MT_IP}/2049" 2>/dev/null; then
        die "TCP 2049 ke ${MT_IP} tertutup. Security group mount target EFS harus mengizinkan inbound TCP 2049 dari security group instance EB ini."
      fi

      log "mounting $FS_ID -> $MOUNT_POINT"
      timeout 120 mount -t efs -o tls,noresvport "$FS_ID:/" "$MOUNT_POINT" \
        || die "mount gagal atau melewati 120 detik."

      mountpoint -q "$MOUNT_POINT" || die "$MOUNT_POINT tidak ter-mount."

      # Baru sekarang aman dipasang permanen. `nofail` supaya EFS yang sedang
      # bermasalah menunda boot, bukan menggagalkannya.
      echo "${FS_ID}:/ $MOUNT_POINT efs _netdev,nofail,tls,noresvport 0 0" >> /etc/fstab

      # -----------------------------------------------------------------------
      # Inisialisasi struktur folder.
      #
      # Aplikasi TIDAK PERNAH memanggil mkdir sebelum menyimpan file — lihat
      # uploadFile() di libs/functions.php yang langsung move_uploaded_file() ke
      # UPLOADFOLDER.$dir."/". Kalau subfolder-nya belum ada, PHP hanya memberi
      # warning dan mengembalikan false: nama file tetap tersimpan di database
      # tapi file fisiknya tidak pernah ada. EFS yang baru dibuat isinya kosong,
      # jadi tanpa langkah ini SEMUA upload gagal tanpa suara.
      #
      # Daftar di bawah adalah gabungan folder yang direferensikan di kode
      # (UPLOADFOLDER."<x>/") dan yang dipakai lewat nama tabel di
      # refController::  uploads/<tbl>/.
      # -----------------------------------------------------------------------
      mkdir -p "$UPLOADS"
      for d in \
        docs \
        dtp \
        kml \
        monitoring \
        pengumuman \
        peta_sebaran \
        raport \
        respon \
        rhl_detail \
        rth \
        rth_detail \
        rth_detail_json \
        sk_pelaksana \
        tutupan \
        tutupan_detail \
        tutupan_detail_json
      do
        mkdir -p "$UPLOADS/$d"
      done

      # chown non-rekursif: cukup untuk direktori yang baru dibuat, dan tidak
      # menyeret seluruh isi EFS setiap deploy (rekursif di atas NFS lambat).
      chown "$WEB_UID:$WEB_GID" "$UPLOADS"
      chmod 2775 "$UPLOADS"
      find "$UPLOADS" -maxdepth 1 -mindepth 1 -type d \
        -exec chown "$WEB_UID:$WEB_GID" {} + \
        -exec chmod 2775 {} +

      log "siap:"
      df -h "$MOUNT_POINT"

commands:
  # Dieksekusi urut abjad: swap harus ada sebelum dnf dijalankan.
  00_swap:
    command: "/opt/ensure-swap.sh"
  01_mount_efs:
    command: "/opt/mount-efs.sh"
